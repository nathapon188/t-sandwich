# Copy this file to .env for local development.
# .env is git-ignored. Never commit the real key.
#
# On Netlify, set the same variable under:
#   Site configuration > Environment variables > WSH_KEY
#
# Anyone with the site link AND this key can view the orders, so treat it
# like a password and rotate it if it is shared too widely.
WSH_KEY=change-me

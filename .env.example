# Copy this file to .env for local development.
# .env is git-ignored. Never commit real keys.
#
# On Netlify, set the same variables under:
#   Site configuration > Environment variables
#
# Do NOT prefix either with VITE_ — that would expose them in the browser bundle.

# Shared access key. Anyone with the site link AND this key can view, edit and
# sync orders, so treat it like a password and rotate it if it spreads too far.
WSH_KEY=change-me

# Anthropic API key, used only by the image import endpoint. Without it the app
# still works; only "Import from image" is unavailable.
ANTHROPIC_API_KEY=
